{
  "expo": {
    "name": "SpendSense",
    "slug": "spendsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendsense",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akhilsingh2.spendsense",
      "infoPlist": {
        "NSCameraUsageDescription": "SpendSense uses the camera to attach receipt photos to an expense.",
        "NSPhotoLibraryUsageDescription": "SpendSense uses your photo library so you can attach a receipt.",
        "NSFaceIDUsageDescription": "SpendSense uses Face ID to unlock your expense ledger."
      }
    },
    "android": {
      "package": "com.akhilsingh2.spendsense",
      "adaptiveIcon": {
        "backgroundColor": "#10281F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3EEE6"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0E6B4F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SpendSense uses Face ID to unlock your expense ledger."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpendSense uses your photo library so you can attach a receipt.",
          "cameraPermission": "SpendSense uses the camera to attach receipt photos to an expense.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
