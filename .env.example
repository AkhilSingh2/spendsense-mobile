# SpendSense runs with no keys. Leave these blank for the on-device mock parser.

# mock (default) | openai
EXPO_PUBLIC_AI_MODE=mock

# Used only when EXPO_PUBLIC_AI_MODE=openai
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional backup. Empty means the ledger never leaves the device.
# Point this at the server in /server when you want sync.
EXPO_PUBLIC_SYNC_URL=
EXPO_PUBLIC_SYNC_TOKEN=

# Server-only. Not read by the Expo app.
PORT=8787
SYNC_TOKEN=
